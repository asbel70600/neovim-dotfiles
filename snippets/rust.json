{
    "ErrorEnum": {
        "prefix": "enumErr",
        "body": [
            "#[derive(std::fmt::Debug)]",
            "enum ${1:Type}Error {",
            "\t${2:VarOne}${3:(Content)},",
            "\t${4:VarTwo}${5:(Content)},",
            "}",
            "impl std::fmt::Display for ${1:Type}Error {",
            "\tfn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {",
            "\t\twrite!(f, \"{self:#?}\")",
            "\t}",
            "}"
        ]
    }
}

